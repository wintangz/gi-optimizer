{
  "name": "gi-optimizer",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @gi/engine build && pnpm --filter @gi/web dev",
    "build": "pnpm --filter @gi/engine build && pnpm -r build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint"
  }
}

